{% liquid
  assign bundle_collection = section.settings.collection
  assign bundle_products = bundle_collection.products | default: collections.all.products
  assign bundle_products = bundle_products | slice: 0, section.settings.products_to_show
%}

<section class="purelane-section" id="{{ section.settings.anchor_id | default: 'bundles' }}">
  <div class="purelane-container">
    <div class="purelane-section-heading">
      <div class="purelane-kicker">{{ section.settings.kicker }}</div>
      <h2 class="purelane-heading">{{ section.settings.heading }}</h2>
      <div class="purelane-rule"><i></i><svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3.5c.7 0 1.4.4 1.8 1.1l2.6 5.1 5.7 1.5c1 .3 1.4 1.6.7 2.4l-3.8 4.2 1 5.7c.2 1-.9 1.8-1.8 1.3l-5.3-2.9-5.3 2.9c-.9.5-2-.3-1.8-1.3l1-5.7-3.8-4.2c-.7-.8-.3-2.1.7-2.4l5.7-1.5 2.7-5.1c.4-.7 1.1-1.1 1.8-1.1Z"/></svg><i></i></div>
      <p class="purelane-lede">{{ section.settings.description }}</p>
    </div>

    <div class="purelane-bundle-list">
      {% for product in bundle_products %}
        {% assign variant = product.selected_or_first_available_variant | default: product.variants.first %}
        <article class="purelane-bundle{% if forloop.first %} purelane-bundle--featured{% endif %}">
          <span class="purelane-bundle__tag">{{ section.settings.badge_text }}</span>
          <div class="purelane-card__media" style="height: 150px; margin: 16px 0;">
            {% if product.featured_media %}
              <img
                class="purelane-card__image"
                src="{{ product.featured_media | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="purelane-fallback" role="img" aria-label="{{ product.title | escape }} placeholder image">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M21 19.1V5.9A2.9 2.9 0 0 0 18.1 3H5.9A2.9 2.9 0 0 0 3 5.9v13.2A2.9 2.9 0 0 0 5.9 21h12.2A2.9 2.9 0 0 0 21 19.1ZM7.3 8.2a1.3 1.3 0 1 1 2.6 0 1.3 1.3 0 0 1-2.6 0Zm11.3 10.5-4-4.4a1.1 1.1 0 0 0-1.6-.1l-2.1 2.1-2.4-2.4a1.1 1.1 0 0 0-1.6 0L5.4 16.3v1.4h13.2v.9Zm0-8.3v6.1l-3.6-3.6 1.4-1.5c.4-.4 1-.4 1.4 0l.8.8 1.9-2.1c.4-.4 1-.4 1.4 0Z"/>
                </svg>
              </div>
            {% endif %}
          </div>

          <h3 class="purelane-bundle__title purelane-subheading" style="font-size: 18px; margin-bottom: 10px;">{{ product.title | truncate: 30 }}</h3>

          <div class="purelane-bundle__price">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
          </div>

          <ul class="purelane-bundle__list">
            {% for block in section.blocks %}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.6 16.9 4.7 12l1.4-1.4 3.5 3.5 8.3-8.3 1.4 1.4-9.7 9.7Z"/></svg>
                {{ block.settings.text }}
              </li>
            {% endfor %}
          </ul>

          <form method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <button type="submit" class="purelane-button purelane-button--primary purelane-bundle__button" {% unless variant.available %}disabled aria-disabled="true"{% endunless %}>
              {% if variant.available %}
                {{ section.settings.cta_label }}
              {% else %}
                {{ 'products.product.sold_out' | t }}
              {% endif %}
            </button>
          </form>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "bundles"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Mix & match"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your bundle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Start with daily essentials and layer in your favorites for a smarter, more affordable routine."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label",
      "default": "Value"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Add bundle"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to show"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Bundle benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Save 15% compared with buying individually"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        { "type": "feature", "settings": { "text": "Save 15% compared with buying individually" } },
        { "type": "feature", "settings": { "text": "Curated essentials for one room at a time" } },
        { "type": "feature", "settings": { "text": "Simple refill-first routine for less waste" } }
      ]
    }
  ]
}
{% endschema %}
